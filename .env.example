# URL y claves del proyecto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Clave service_role — NUNCA exponer al cliente, solo se usa en Route Handlers server-side
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URL pública del sitio, usada para construir los enlaces de invitación/reset de Supabase Auth
# En local: http://localhost:3000 — en producción: la URL de Vercel
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcionales — identidad del club/equipo para este despliegue (ver README
# "Desplegar para otro club" y src/lib/club-config.ts). Sin rellenar, se
# usan los valores del Infantil B de la Cultural y Deportiva Leonesa.
# NEXT_PUBLIC_CLUB_NOMBRE=Cultural y Deportiva Leonesa
# NEXT_PUBLIC_EQUIPO_NOMBRE=Infantil B
# NEXT_PUBLIC_ESCUDO_INICIALES=IB
# NEXT_PUBLIC_COLOR_PRIMARIO=#8a1b24
# NEXT_PUBLIC_COLOR_SECUNDARIO=#9c7328
# NEXT_PUBLIC_LUGAR_ENTRENO_DEFECTO=Área Deportiva de Puente Castro
